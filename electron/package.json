{
  "name": "papeleria-pos-electron",
  "version": "1.0.0",
  "description": "Electron frontend for Papeleria POS",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "tsc && npm run build:frontend && npm run build:backend",
    "build:frontend": "cd ../frontend && npm run build",
    "build:backend": "cd ../backend && npm run build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5",
    "tsx": "^4.7.0"
  },
  "build": {
    "appId": "com.papeleria.pos",
    "productName": "Papeleria POS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  }
}
