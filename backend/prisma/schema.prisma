generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("{}")
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String?  @unique
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  status       UserStatus @default(ACTIVE)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sales        Sale[]
  inventoryMoves InventoryMove[]
  cashRegisters CashRegister[]
  cashRegisterMoves CashRegisterMovement[]
  auditLogs    AuditLog[]
  returns      Return[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  status      Boolean  @default(true)
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  status      Boolean  @default(true)
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("brands")
}

model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  barcode         String?  @unique
  name            String
  description     String?
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?   @relation(fields: [brandId], references: [id])
  unit            String   @default("UNI")
  purchasePrice   Decimal  @db.Decimal(10, 2)
  salePrice       Decimal  @db.Decimal(10, 2)
  wholesalePrice  Decimal? @db.Decimal(10, 2)
  stock           Int      @default(0)
  stockMin        Int      @default(1)
  stockMax        Int?
  location        String?
  active          Boolean  @default(true)
  imagePrimary    String?
  images          ProductImage[]
  inventoryMoves  InventoryMove[]
  saleItems       SaleItem[]
  returnItems     ReturnItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("products")
  @@index([name])
  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)
  fileSize   Int?
  mimeType   String?
  createdAt  DateTime @default(now())

  @@map("product_images")
}

model InventoryMove {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  type         MoveType
  quantity     Int
  reference    String?
  referenceId  String?
  notes        String?
  stockBefore  Int
  stockAfter   Int
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())

  @@map("inventory_moves")
  @@index([productId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

enum MoveType {
  ENTRADA
  SALIDA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  VENTA
  MERMA
  DANADO
  DEVOLUCION_COMPRA
  INVENTARIO_INICIAL
  OTRO
}

model Sale {
  id          String    @id @default(cuid())
  folio       String    @unique
  date        DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  subtotal    Decimal   @db.Decimal(10, 2)
  discount    Decimal   @default(0) @db.Decimal(10, 2)
  total       Decimal   @db.Decimal(10, 2)
  amountPaid  Decimal   @db.Decimal(10, 2)
  change      Decimal   @db.Decimal(10, 2)
  paymentMethod String  @default("EFECTIVO")
  status      SaleStatus @default(COMPLETED)
  cancelReason String?
  cancelledBy String?
  cancelledAt DateTime?
  saleItems   SaleItem[]
  payment     Payment?
  returns     Return[]
  cashRegisterId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("sales")
  @@index([date])
  @@index([userId])
  @@index([status])
  @@index([folio])
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@map("sale_items")
  @@index([saleId])
  @@index([productId])
}

model Payment {
  id         String   @id @default(cuid())
  saleId     String   @unique
  sale       Sale     @relation(fields: [saleId], references: [id])
  amount     Decimal  @db.Decimal(10, 2)
  method     String   @default("EFECTIVO")
  change     Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  @@map("payments")
}

model Return {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  reason     String
  total      Decimal  @db.Decimal(10, 2)
  status     ReturnStatus @default(PENDING)
  returnItems ReturnItem[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("returns")
  @@index([saleId])
  @@index([userId])
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  return    Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  reason    String?
  createdAt DateTime @default(now())

  @@map("return_items")
  @@index([returnId])
  @@index([productId])
}

model CashRegister {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  openDate     DateTime @default(now())
  closeDate    DateTime?
  initialFund  Decimal  @db.Decimal(10, 2)
  expectedCash Decimal  @default(0) @db.Decimal(10, 2)
  countedCash  Decimal? @db.Decimal(10, 2)
  difference   Decimal? @db.Decimal(10, 2)
  status       CashRegisterStatus @default(OPEN)
  salesCount   Int      @default(0)
  movements    CashRegisterMovement[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("cash_registers")
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegisterMovement {
  id             String    @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  type           String
  amount         Decimal    @db.Decimal(10, 2)
  reference      String?
  notes          String?
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  createdAt      DateTime   @default(now())

  @@map("cash_register_movements")
  @@index([cashRegisterId])
  @@index([userId])
}

model BusinessSettings {
  id             String   @id @default(cuid())
  businessName   String   @default("Papeleria")
  address        String?
  phone          String?
  logo           String?
  currency       String   @default("PEN")
  taxRate        Decimal  @default(18) @db.Decimal(5, 2)
  folioPrefix    String   @default("V")
  ticketFormat   String   @default("STANDARD")
  defaultStockMin Int     @default(1)
  allowNegativeStock Boolean @default(false)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@map("business_settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entity     String?
  entityId   String?
  ip         String?
  details    Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
